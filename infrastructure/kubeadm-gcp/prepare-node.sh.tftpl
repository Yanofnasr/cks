#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -euo pipefail
umask 077
install -d -m 0700 /var/lib/cks /var/log/cks
exec 9>/var/lib/cks/prepare.lock
flock -n 9 || exit 0
if test -f /var/lib/cks/prepared; then
  test "$(cat /var/lib/cks/prepared)" = '${kubernetes_version}'
  exit 0
fi
# Never reconfigure a VM that has already joined or initialized a cluster.
test ! -f /etc/kubernetes/kubelet.conf
test ! -f /etc/kubernetes/admin.conf
exec > /var/log/cks/prepare.log 2>&1
. /etc/os-release
test "$ID" = ubuntu && test "$VERSION_ID" = 24.04
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates curl gpg
install -m 0755 -d /etc/apt/keyrings
curl --fail --location --retry 3 https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/cks-docker.asc
chmod 0644 /etc/apt/keyrings/cks-docker.asc
printf 'deb [arch=%s signed-by=/etc/apt/keyrings/cks-docker.asc] https://download.docker.com/linux/ubuntu noble stable\n' \
  "$(dpkg --print-architecture)" > /etc/apt/sources.list.d/cks-containerd.list
curl --fail --location --retry 3 https://pkgs.k8s.io/core:/stable:/v1.37/deb/Release.key -o /var/lib/cks/kubernetes.key
gpg --batch --yes --dearmor -o /etc/apt/keyrings/cks-kubernetes.gpg /var/lib/cks/kubernetes.key
chmod 0644 /etc/apt/keyrings/cks-kubernetes.gpg
printf '%s\n' 'deb [signed-by=/etc/apt/keyrings/cks-kubernetes.gpg] https://pkgs.k8s.io/core:/stable:/v1.37/deb/ /' > /etc/apt/sources.list.d/cks-kubernetes.list
apt-get update
apt-get install -y 'containerd.io=${containerd_package}' \
  'kubeadm=${kubernetes_package}' 'kubelet=${kubernetes_package}' 'kubectl=${kubernetes_package}'
apt-mark hold containerd.io kubeadm kubelet kubectl
install -d -m 0755 /etc/containerd
containerd config default > /etc/containerd/config.toml
sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
grep -q 'SystemdCgroup = true' /etc/containerd/config.toml
systemctl enable --now containerd
systemctl restart containerd
modprobe overlay
modprobe br_netfilter
printf '%s\n' overlay br_netfilter > /etc/modules-load.d/cks.conf
printf '%s\n' 'net.ipv4.ip_forward = 1' 'net.bridge.bridge-nf-call-iptables = 1' > /etc/sysctl.d/90-cks.conf
sysctl --system
swapoff -a
cp -a /etc/fstab /var/lib/cks/fstab.before
awk '$1 !~ /^#/ && $3 == "swap" {$0="# cks disabled swap: " $0} {print}' /etc/fstab > /var/lib/cks/fstab.new
cat /var/lib/cks/fstab.new > /etc/fstab
systemctl enable kubelet
crictl --runtime-endpoint unix:///run/containerd/containerd.sock info >/dev/null
test -d /opt/cni/bin
printf '%s\n' '${kubernetes_version}' > /var/lib/cks/prepared
# The public host-key fingerprint can be compared through the trusted serial console.
ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub > /dev/console
